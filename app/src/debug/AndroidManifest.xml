<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: background trigger for IconDumper (see tools/icon_dump/README.md).
             DUMP is held by adb shell, so other apps can't trigger it. -->
        <receiver
            android:name=".debug.IconDumpReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Debug builds only: builds and signs a test icon pack (Keystore + apksig check). -->
        <receiver
            android:name=".debug.PackSpikeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
